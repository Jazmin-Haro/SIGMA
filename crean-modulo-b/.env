# ── Base de datos PostgreSQL ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crean
DB_USER=postgres
DB_PASSWORD=12345
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE=30000
DB_POOL_ACQUIRE=60000

# ── Servidor ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── JWT (Seguridad) ──────────────────────────────────────
# Cambiar por una cadena aleatoria larga y segura
JWT_SECRET=QWhvFNF;K82t3[]?y78ahkL/@
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────
# Origen del frontend (React)
CORS_ORIGIN=http://localhost:5173

          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/maquinaria/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado_operativo\": \"disponible\",\n  \"horas_actuales\": 1250,\n  \"ubicacion\": \"CREAN\"\n}"
            }
          }
        },
        {
          "name": "DELETE Eliminar maquinaria",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": "{{BASE_URL}}/maquinaria/99"
          }
        }
      ]

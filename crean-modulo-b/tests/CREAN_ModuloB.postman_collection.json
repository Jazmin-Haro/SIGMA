              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/maquinaria",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_economico\": \"T050\",\n  \"tipo_equipo\": \"Tractor\",\n  \"marca\": \"NEW HOLLAND\",\n  \"modelo\": \"7610S 4WD\",\n  \"serie\": \"S508999Z\",\n  \"num_motor\": \"8129000\",\n  \"horas_actuales\": 500,\n  \"ubicacion\": \"CREAN\"\n}"
            }

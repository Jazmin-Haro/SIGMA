            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/maquinaria?estado=disponible", "query": [{ "key": "estado", "value": "disponible" }] }
          }
        },
        {
          "name": "GET Maquinaria por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": "{{BASE_URL}}/maquinaria/1"
